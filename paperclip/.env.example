# Optional overrides for both Compose samples; copy to .env if desired.
# All settings can also be supplied through shell environment variables.


# --- Container image and user ---

PAPERCLIP_IMAGE=ghcr.io/nov12/paperclip:latest
PUID=666
PGID=666


# --- Networking ---
# PAPERCLIP_PORT only controls the host port; the container listens on 3100.
# The public sample always binds to 127.0.0.1 and ignores PAPERCLIP_BIND_IP.
# PAPERCLIP_PUBLIC_URL is the primary browser URL used for links and authentication.
# Use your LAN IP or browser-facing Caddy URL; its hostname is automatically trusted.
# The local default follows PAPERCLIP_PORT.
# PAPERCLIP_ALLOWED_HOSTNAMES adds other trusted hostnames, separated by commas.
# Use hostnames only, without schemes, ports, or paths; leave empty when not needed.

# Reverse-proxy example (inactive):
# PAPERCLIP_PUBLIC_URL=https://paperclip.example.com
# PAPERCLIP_ALLOWED_HOSTNAMES=paperclip-alt.example.net,paperclip-vpn.example.org

# Active settings:

PAPERCLIP_BIND_IP=0.0.0.0
PAPERCLIP_PORT=3100
PAPERCLIP_PUBLIC_URL=http://localhost:${PAPERCLIP_PORT}
PAPERCLIP_ALLOWED_HOSTNAMES=


# --- Paperclip authentication and database ---
# BETTER_AUTH_SECRET signs login sessions.
# PAPERCLIP_TOOL_ACTION_SIGNING_SECRET signs tool-action approvals.
# Run openssl rand -hex 32 separately for each secret and keep both values stable.
# Rotating the tool-action secret invalidates outstanding approval signatures.
# The public sample also requires DATABASE_URL and an HTTPS PAPERCLIP_PUBLIC_URL.
# Leave DATABASE_URL unset to use embedded PostgreSQL in the private sample.

# Database connection example (inactive):
# DATABASE_URL=postgresql://paperclip:replace-with-password@db.example.com:5432/paperclip

# Active settings:

BETTER_AUTH_SECRET=
PAPERCLIP_TOOL_ACTION_SIGNING_SECRET=


# --- Agent CLI installation and updates ---
# Agent CLIs: all, none, an empty value, or comma-separated name[@version].
# Install modes: skip=reuse, update=default, overwrite=reinstall.
# CLI_UPDATE_INTERVAL: 0 disables periodic checks but still runs startup checks.

# Version example (inactive):
# AGENT_CLIS=codex@0.166.0,claude@2

# Optional override (inactive; uncomment to enable):
# CLI_INSTALL_MODE=update

# Active settings:

AGENT_CLIS=codex,claude,opencode,pi,kimi
CLI_UPDATE_INTERVAL=86400


# --- Optional development tools and Python packages ---
# Uncomment to select tools and packages to install.
# Install modes: skip=reuse, update=default, overwrite=reinstall.
# TOOLS_UPDATE_INTERVAL: checked at startup only; 0 reuses matching tools.

# Package selections (inactive; uncomment to enable):
# EXTRA_TOOLS=go,python@3.13,node@22,dotnet@lts
# PYTHON_PACKAGES='"requests>=2,<3",ruff'

# Installation and update overrides (inactive; uncomment to enable):
# TOOLS_INSTALL_MODE=update
# TOOLS_UPDATE_INTERVAL=86400


# --- Provider API keys ---
# Optional provider API keys; leave empty when using CLI authentication.

OPENAI_API_KEY=
ANTHROPIC_API_KEY=
GEMINI_API_KEY=
GOOGLE_API_KEY=
