# Copy to .env; uncomment optional mappings in the Compose file.

# Container image and user IDs.

PAPERCLIP_IMAGE=ghcr.io/nov12/paperclip:latest
PUID=666
PGID=666

# Host-side address/port; the public sample always binds to 127.0.0.1.

PAPERCLIP_BIND_IP=0.0.0.0
PAPERCLIP_PORT=3100

# Browser URL: use your LAN IP/domain; the public sample requires HTTPS.

PAPERCLIP_PUBLIC_URL=http://localhost:${PAPERCLIP_PORT}

# Extra hostnames, comma-separated; the URL hostname is already allowed.

PAPERCLIP_ALLOWED_HOSTNAMES=

# Required secrets: run openssl rand -hex 32 separately for each; keep stable.

BETTER_AUTH_SECRET=
PAPERCLIP_TOOL_ACTION_SIGNING_SECRET=

# PostgreSQL URL: required for public; commented = embedded for private.

# DATABASE_URL=postgresql://paperclip:replace-with-password@db.example.com:5432/paperclip

# CLIs: comma-separated names or all; none/empty = off; name@version except agy.
# Auto-update: 86400 = every 24h; 0 = startup only (seconds).
# Mode: skip = reuse/no auto-update; update = auto-update; overwrite = reinstall.

AGENT_CLIS=codex,claude,opencode,pi,kimi
CLI_UPDATE_INTERVAL=86400
CLI_INSTALL_MODE=update

# Tools: go,dotnet,python,uv,rust,node,bun,deno,java; name@version; none/empty = off.
# Python packages: e.g. requests,ruff; Python is enabled automatically.
# Mode: skip = reuse; update = check; overwrite = reinstall.
# Checks: startup only (seconds); 0 = reuse; overwrite ignores the interval.

EXTRA_TOOLS=
PYTHON_PACKAGES=
TOOLS_INSTALL_MODE=update
TOOLS_UPDATE_INTERVAL=86400

# Optional provider API keys; CLI login also works.

OPENAI_API_KEY=
ANTHROPIC_API_KEY=
GEMINI_API_KEY=
GOOGLE_API_KEY=
