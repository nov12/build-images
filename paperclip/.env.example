# Copy to .env and adjust values as needed.

# Container image and UID/GID.
PAPERCLIP_IMAGE=ghcr.io/nov12/paperclip:latest
PUID=666
PGID=666

# Host binding (public sample always binds 127.0.0.1).
PAPERCLIP_BIND_IP=0.0.0.0
PAPERCLIP_PORT=3100

# Browser-facing URL (public sample requires HTTPS).
PAPERCLIP_PUBLIC_URL=http://localhost:${PAPERCLIP_PORT}

# Extra allowed hostnames (comma-separated).
PAPERCLIP_ALLOWED_HOSTNAMES=

# Required secrets (generate separately with openssl rand -hex 32; keep stable).
BETTER_AUTH_SECRET=
PAPERCLIP_TOOL_ACTION_SIGNING_SECRET=

# External PostgreSQL URL (required for public; commented = embedded for private).
# DATABASE_URL=postgresql://paperclip:replace-with-password@db.example.com:5432/paperclip

# codex,claude,opencode,gemini,qwen,kimi,copilot,pi,cline,amp,agy | all | none (name@version except agy)
AGENT_CLIS=codex,claude,opencode,pi,kimi

# Update interval in seconds; 0 = startup only.
CLI_UPDATE_INTERVAL=86400

# skip | update | overwrite
CLI_INSTALL_MODE=update

# go,dotnet,python,uv,rust,node,bun,deno,java | none (supports name@version)
EXTRA_TOOLS=

# Comma-separated Python packages, e.g. requests,ruff (auto-enables python).
PYTHON_PACKAGES=

# skip | update | overwrite
TOOLS_INSTALL_MODE=update

# Startup check interval in seconds; 0 = reuse.
TOOLS_UPDATE_INTERVAL=86400

# Provider API keys.
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
GEMINI_API_KEY=
GOOGLE_API_KEY=
